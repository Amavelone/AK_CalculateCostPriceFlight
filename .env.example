# Development may omit every setting and uses repository-local backend/data paths.
APP_ENV=development
MONITOR_DATA_DIRECTORY=
MONITOR_SOURCE_DIRECTORY=
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Production requires explicit, existing absolute directories. Keep real values
# in the deployment secret/configuration store; never commit a .env file.
# APP_ENV=production
# MONITOR_DATA_DIRECTORY=C:\\cost-monitor\\data
# MONITOR_SOURCE_DIRECTORY=C:\\cost-monitor\\sources
# HOST=127.0.0.1
# PORT=8000
# LOG_LEVEL=INFO
